{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.json", ".npmrc", "pnpm-lock.yaml"],
  "globalEnv": ["NODE_ENV", "CI", "DATABASE_URL", "SHADOW_DATABASE_URL", "DATABASE_APP_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "theme/**",
        "tsconfig*.json",
        "package.json",
        "prisma/**",
        "prisma.config.ts"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "theme/**",
        "tsconfig*.json",
        "package.json",
        "prisma/**",
        "prisma.config.ts"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "theme/**",
        "tsconfig*.json",
        "package.json",
        "prisma/**",
        "prisma.config.ts",
        "vitest.config.ts",
        "vitest.config.mts"
      ],
      "outputs": [],
      "env": [
        "DATABASE_URL",
        "SHADOW_DATABASE_URL",
        "DATABASE_APP_URL",
        "SEED_ADMIN_EMAIL",
        "SEED_ADMIN_PASSWORD"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
