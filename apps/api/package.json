{
  "name": "@kairos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kairos NestJS API. The only process that may import @kairos/database.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --build",
    "start": "node dist/main.js",
    "typecheck": "tsc --build --pretty false",
    "test": "vitest run",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@kairos/config": "workspace:*",
    "@kairos/database": "workspace:*",
    "@kairos/types": "workspace:*",
    "@kairos/validation": "workspace:*",
    "@nestjs/common": "12.0.2",
    "@nestjs/core": "12.0.2",
    "@nestjs/platform-express": "12.0.2",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
