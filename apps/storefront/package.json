{
  "name": "@kairos/storefront",
  "version": "0.0.0",
  "private": true,
  "description": "Kairos customer storefront. Next.js App Router, French, mobile-first. No Prisma.",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "node scripts/copy-fonts.mjs",
