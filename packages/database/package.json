{
  "name": "@kairos/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and client. Owned by DATABASE_AGENT. Only apps/api may depend on this package.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc --build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "clean": "tsc --build --clean",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema --exit-code",
    "db:seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@kairos/types": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@kairos/config": "workspace:*",
    "@types/pg": "8.15.6",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
