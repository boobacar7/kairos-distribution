{
  "name": "@kairos/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and client. Owned by DATABASE_AGENT. Only apps/api may depend on this package.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "test": "vitest run --passWithNoTests",
    "clean": "tsc --build --clean",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@kairos/config": "workspace:*",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
