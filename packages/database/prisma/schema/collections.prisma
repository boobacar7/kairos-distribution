model Collection {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  description     String?
  imageAssetId    String?
  type            CollectionType  @default(MANUAL)
  ruleMatchMode   RuleMatchMode?  @default(ALL)
  isActive        Boolean         @default(true)
  position        Int             @default(0)
  seoTitle        String?
  seoDescription  String?
  lastRefreshedAt DateTime?       @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?       @db.Timestamptz(6)

  image     MediaAsset?          @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  rules     CollectionRule[]
  products  CollectionProduct[]
  discounts DiscountCollection[]

  @@index([isActive, position])
  @@index([imageAssetId])
  @@map("collections")
}

model CollectionRule {
  id           String              @id @default(cuid())
  collectionId String
  field        CollectionRuleField
  operator     RuleOperator
  value        Json
  position     Int                 @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, position])
  @@map("collection_rules")
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int                         @default(0)
  source       CollectionMembershipSource  @default(MANUAL)
  addedAt      DateTime                    @default(now()) @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@index([collectionId, position])
  @@map("collection_products")
}
