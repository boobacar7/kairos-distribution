model Review {
  id                     String       @id @default(cuid())
  orderItemId            String       @unique
  orderId                String
  productId              String
  customerId             String
  rating                 Int
  title                  String?
  comment                String
  photoAssetId           String?
  status                 ReviewStatus @default(PENDING_MODERATION)
  isFeatured             Boolean      @default(false)
  isVerifiedPurchase     Boolean      @default(true)
  moderatedByAdminUserId String?
  moderatedAt            DateTime?    @db.Timestamptz(6)
  rejectionReason        String?
  publishedAt            DateTime?    @db.Timestamptz(6)
  adminReply             String?
  createdAt              DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(6)

  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  photo       MediaAsset? @relation(fields: [photoAssetId], references: [id], onDelete: SetNull)
  moderatedBy AdminUser? @relation("ReviewModerator", fields: [moderatedByAdminUserId], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([photoAssetId])
  @@index([moderatedByAdminUserId])
  @@map("reviews")
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId])
  @@map("wishlist_items")
}
