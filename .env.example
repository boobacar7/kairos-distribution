# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
# This file contains local development placeholders only. No real credential, API key or
# production connection string belongs in this repository — see docs/architecture.md R8.
#
# Every variable here is validated at process start by the zod schema in @kairos/config/env,
# so a missing or malformed value fails the boot with a readable message rather than a runtime
# error on the first query that needs it.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database — matches the docker-compose defaults
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://kairos:kairos@localhost:5432/kairos_dev?schema=public
SHADOW_DATABASE_URL=postgresql://kairos:kairos@localhost:5432/kairos_shadow?schema=public
DATABASE_APP_URL=postgresql://kairos_app:kairos_app@localhost:5432/kairos_dev?schema=public

# Dev seed (local/CI only). The seed throws if either is unset; there is no default password.
# SEED_ADMIN_EMAIL=dev-admin@example.test
# SEED_ADMIN_PASSWORD=

# Overrides for docker-compose, if the defaults clash with something already running locally.
# POSTGRES_USER=kairos
# POSTGRES_PASSWORD=kairos
# POSTGRES_DB=kairos_dev
# POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Added by later phases — listed so nobody invents a different name for them
# ---------------------------------------------------------------------------
# Phase 4  JWT_SECRET                  access token signing key
# Phase 4  REFRESH_TOKEN_PEPPER        additional secret for refresh token hashing
# Phase 5  STORAGE_PROVIDER            local | cloudinary | s3
# Phase 5  PORT                        API listen port (default 4000)
# Phase 5  CORS_ORIGIN                 storefront origin, e.g. http://127.0.0.1:3000
# Phase 6  KAIROS_API_URL              public API origin, e.g. http://127.0.0.1:4000
# Phase 6  STOREFRONT_SITE_URL         canonical storefront origin for sitemap/robots
# Phase 6  STOREFRONT_REVALIDATE_SECRET  HMAC secret for POST /api/revalidate
# Phase 6  STOREFRONT_USE_TEST_CATALOGUE  true to render [TEST] products in non-production (otherwise the approved visual homepage stub)
# Phase 13 PAYMENT_WEBHOOK_VAULT_KEY   encryption key for the short-TTL webhook payload vault
