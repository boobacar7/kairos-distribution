# Strict, non-flat node_modules is the mechanism that enforces the package boundaries in
# docs/architecture.md §3: a package can only import what its own package.json declares.
# Do not set shamefully-hoist or node-linker=hoisted — that disables the guardrail.
hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# Exact versions. Thirteen agents run installs independently; a caret range is how two of them
# end up on different framework minors. The lockfile is the contract.
save-exact=true

engine-strict=true
